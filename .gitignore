# --- Secrets ---------------------------------------------------------------
.env
*.env
!.env.example

# --- Python ----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Logs ------------------------------------------------------------------
*.log

# --- Raw corpus ------------------------------------------------------------
# Scraped wiki text. Not committed (assignment constraint); the README documents
# exactly which pages were used and where they came from so it can be re-fetched.
data/raw/

# --- Large media -----------------------------------------------------------
# Gameplay footage and extracted frames are far too large for git.
data/images/raw_footage/
data/images/frames/
data/images/dataset/
data/images/dataset5/

# --- Training runs ---------------------------------------------------------
# Ultralytics writes weights, plots, batch previews and results.csv per run.
# Regenerated by re-running the YOLO notebook. The single best.pt that the
# backend actually loads IS committed, under backend/data/yolo_model/.
runs/

# --- Local model artifacts -------------------------------------------------
# Stock Ultralytics base checkpoints. Downloaded on demand by ultralytics
# itself, so they are reproducible without being tracked -- and they are not
# what the backend loads. The fine-tuned weights that ARE loaded are committed
# at backend/data/yolo_model/best.pt.
yolov8n.pt
weights/

# The notebook's export is a *build artifact*: Chroma gives the HNSW index
# directory a fresh random UUID on every run, so tracking it would churn the repo
# on every re-execution. It is regenerated by running rag_pipeline.ipynb.
notebooks/vector_store_export/

# The copy the backend actually loads IS committed, which is what lets a fresh
# clone run without re-executing the notebook. It is ~7 MB, comfortably under the
# ~50 MB threshold; uncomment the line below to exclude it if the corpus grows.
#
# Tradeoff: Chroma rewrites its sqlite on open, so merely starting the backend
# shows the store as modified in `git status`. That churn is cosmetic -- content
# and chunk count are unchanged. Verify before committing with:
#   curl localhost:8000/health   # expect vector_store.chunks == 627
# backend/data/vector_store/

# --- Validation scratch ----------------------------------------------------
notebooks/_validation_run.ipynb

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
