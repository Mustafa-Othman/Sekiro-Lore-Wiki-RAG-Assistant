# Frontend configuration. Copy to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is gitignored; this example file is committed.

# Base URL of the FastAPI backend.
#
# The frontend must NEVER hard-code http://localhost:8000 -- it always reads
# this value, so pointing the UI at a deployed backend needs no code change.
API_BASE_URL=http://localhost:8000
