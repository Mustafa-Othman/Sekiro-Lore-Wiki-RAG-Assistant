# Backend configuration. Copy to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is gitignored; this example file is committed.

# --- Local LLM (Ollama) ----------------------------------------------------
# Model must be pulled first:  ollama pull qcwind/qwen2.5-7B-instruct-Q4_K_M
# Any instruct model works -- e.g. llama3, mistral. Bigger models give better
# answers and are slower; this 7B Q4 quant answers in ~2-15s per question on CPU.
OLLAMA_MODEL=qcwind/qwen2.5-7B-instruct-Q4_K_M
OLLAMA_HOST=http://localhost:11434

# --- Vector store ----------------------------------------------------------
# Path to the ChromaDB store produced by notebooks/rag_pipeline.ipynb.
VECTOR_STORE_PATH=./data/vector_store
VECTOR_STORE_COLLECTION=sekiro_wiki

# Must match the model used in notebooks/rag_pipeline.ipynb, or query embeddings
# will be incompatible with the stored chunks.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunks retrieved per query.
TOP_K=4

# --- CORS ------------------------------------------------------------------
# Origin the Streamlit frontend is served from.
FRONTEND_ORIGIN=http://localhost:8501

# --- Extended Track: YOLO boss detection (optional) ------------------------
# Unset (the default) runs the Core Track pipeline only -- detection is skipped,
# never fatal. Uncomment once you have trained weights.
# YOLO_MODEL_PATH=./data/yolo_model/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
